load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "core",
    hdrs = glob(["**/*.hpp"]),
    visibility = ["//visibility:public"],
    copts = select({
        "//:cpp17": ["-std=c++17"],
        "//:cpp20": ["-std=c++20"],
        "//:cpp23": ["-std=c++23"],
        "//:cpp26": ["-std=c++26"],
        "//conditions:default": ["-std=c++20"],
    }) + [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Wno-infinite-recursion",
    ],
)
